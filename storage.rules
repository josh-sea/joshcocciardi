rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate video file
    // (200MB ≈ a couple of minutes of phone footage — enough for a
    // "how Gram mixes the dough" technique clip)
    function isValidVideo() {
      return request.resource.size < 200 * 1024 * 1024 // 200MB max
             && request.resource.contentType.matches('video/.*');
    }
    
    // Helper function to validate image file (thumbnails)
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 // 5MB max
             && request.resource.contentType.matches('image/.*');
    }

    // Helper function to validate audio file (voice recordings)
    function isValidAudio() {
      return request.resource.size < 25 * 1024 * 1024 // 25MB max
             && request.resource.contentType.matches('audio/.*');
    }

    // ── Collector Shop item photos ──────────────────────────────────────
    // Photos live under collector/{shopId}/... and are readable/writable by any
    // member of that shop. Membership is checked against the shop document in
    // Firestore, so both collaborators can see each other's photos.
    function collectorShopMember(shopId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/collector_shops/$(shopId))
             .data.memberUids.hasAny([request.auth.uid]);
    }
    match /collector/{shopId}/{allPaths=**} {
      allow read: if collectorShopMember(shopId);
      allow write: if collectorShopMember(shopId) && isValidImage();
      allow delete: if collectorShopMember(shopId);
    }

    // User files path: users/{userId}/**
    match /users/{userId}/{allPaths=**} {
      // Allow read if authenticated user owns the files
      allow read: if isOwner(userId);
      
      // Allow write if authenticated user owns the files and file is valid
      allow write: if isOwner(userId) && (isValidVideo() || isValidImage() || isValidAudio());
      
      // Allow delete if authenticated user owns the files
      allow delete: if isOwner(userId);
    }
  }
}