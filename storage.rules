rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate video file
    // (200MB ≈ a couple of minutes of phone footage — enough for a
    // "how Gram mixes the dough" technique clip)
    function isValidVideo() {
      return request.resource.size < 200 * 1024 * 1024 // 200MB max
             && request.resource.contentType.matches('video/.*');
    }
    
    // Helper function to validate image file (thumbnails)
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 // 5MB max
             && request.resource.contentType.matches('image/.*');
    }

    // Helper function to validate audio file (voice recordings)
    function isValidAudio() {
      return request.resource.size < 25 * 1024 * 1024 // 25MB max
             && request.resource.contentType.matches('audio/.*');
    }

    // ── Collector Shop item photos ──────────────────────────────────────
    // Photos live under collector/{shopId}/{itemId}/{file}. NOTE: Cloud Storage
    // rules cannot read Cloud Firestore (there is no cross-service get()), so we
    // can't verify shop membership here the way the Firestore rules do. Instead
    // access is gated by authentication plus the unguessable path: shopId and
    // itemId are random 20-char Firestore auto-IDs that non-members never see
    // (only shop members can read the item docs that contain the path), and
    // download URLs carry their own secret token. Writes must be valid images.
    //
    // If we ever need true membership enforcement at the Storage layer, the
    // path is a Cloud Function that mints custom auth claims for shop members;
    // that's the only way to bring membership into Storage rules.
    match /collector/{shopId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    // ── Workbook Reader ─────────────────────────────────────────────────
    // Shared, cross-user word-audio cache. Any signed-in user can read every
    // clip (so every child gets instant playback for words others already
    // tapped) and add a missing one. This MUST come before the per-adult
    // /workbook/{userId}/** rule below so "audio" isn't matched as a uid.
    // (Storage rules OR across matching allows, so the owner rule denying
    // isOwner('audio') can't block this.)
    match /workbook/audio/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidAudio();
    }

    // Original workbook page photos, owned by the adult whose uid is the first
    // path segment: workbook/{adultUid}/{kidId}/{pageId}/original.jpg
    match /workbook/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // ── My Reading Buddy ────────────────────────────────────────────────
    // Book spreads and the recordings read over them, under
    // readingbuddy/{shelfId}/{bookId}/{file}. Same approach as the Collector
    // Shop above: Storage rules can't see shelf membership in Firestore, so
    // access is a verified sign-in plus the unguessable path (shelfId and
    // bookId are Firestore auto-ids only members ever see), and download
    // URLs carry their own token. The app shrinks photos to 2400px JPEGs
    // well under the 10MB cap; 25MB of AAC is over an hour of reading.
    function isReadingBuddyUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /readingbuddy/{shelfId}/{allPaths=**} {
      allow read: if isReadingBuddyUser();
      allow write: if isReadingBuddyUser()
        && ((request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || isValidAudio());
      allow delete: if isReadingBuddyUser();
    }

    // ── Seasonal Box HQ ─────────────────────────────────────────────────
    // Mood-board images and raw agent step logs, written only by the Cloud
    // Functions. Readable by the one admin account; never writable by a
    // client. Same allowlist as the sbox_* block in firestore.rules.
    match /sbox/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['joshua.cocciardi@gmail.com'];
      allow write: if false;
    }

    // ── PSX Station save data ───────────────────────────────────────────
    // Owner-only, under psx/{uid}/{discId}/. Deliberately narrow: only the
    // save states, their screenshots and the memory card sync here. Disc
    // images stay in the player's browser, so a 600MB .7z can never land in
    // the bucket (and never costs egress on the way back out).
    //
    // The 32MB ceiling is the same one the app enforces client-side; real PS1
    // states run 1-9MB depending on the core, and a memory card is ~128KB.
    function isValidPsxSave() {
      return request.resource.size < 32 * 1024 * 1024;
    }

    match /psx/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidPsxSave();
      allow delete: if isOwner(userId);
    }

    // ── Mise step attachments ───────────────────────────────────────────
    // mise/{ownerUid}/{implId}/{nodeId}/{file}. Owner-only: the uid leads the
    // path, so the check needs no Firestore read. Any file type, since these
    // are scans, PDFs, and forms; 25MB matches MAX_FILE_BYTES in the client.
    match /mise/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // ── Where Am I photo decks ──────────────────────────────────────────
    // whereami/{deckId}/{file}: the map a deck pins against, and the round
    // photos themselves.
    //
    // Access is a verified sign-in plus the unguessable path, the same shape
    // as the Collector and Reading Buddy blocks above. deckId is a 20-char
    // Firestore auto-id that appears in exactly one place a non-member can
    // reach: nowhere. It lives on the deck document, which the Firestore
    // rules hand out only to members, so knowing this path means a member
    // gave it to you. That is the same capability model the password itself
    // uses, so Storage is not the weak link.
    //
    // Cloud Storage rules CAN check Firestore membership directly these days
    // (firestore.get(), added 2022), and that would be stricter. It is not
    // used here because it could not be verified: the Storage emulator
    // returns null for every cross-service read in this setup, so the rule
    // could only be shipped untested, and its failure mode is that every
    // upload 403s for everybody. A stricter rule that might brick uploads is
    // a bad trade against a weaker one that is proven. Worth revisiting with
    // a newer emulator — the suite in functions/test/ is where it would go.
    //
    // Listing is naturally limited: /whereami/ itself matches no rule, so the
    // prefix cannot be walked without already knowing a deckId.
    function waSignedIn() {
      return request.auth != null;
    }

    match /whereami/{deckId}/{allPaths=**} {
      allow read: if waSignedIn();
      allow write: if waSignedIn() && isValidImage();
      allow delete: if waSignedIn();
    }

    // User files path: users/{userId}/**
    match /users/{userId}/{allPaths=**} {
      // Allow read if authenticated user owns the files
      allow read: if isOwner(userId);
      
      // Allow write if authenticated user owns the files and file is valid
      allow write: if isOwner(userId) && (isValidVideo() || isValidImage() || isValidAudio());
      
      // Allow delete if authenticated user owns the files
      allow delete: if isOwner(userId);
    }
  }
}