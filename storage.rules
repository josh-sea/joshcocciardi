rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate video file
    // (200MB ≈ a couple of minutes of phone footage — enough for a
    // "how Gram mixes the dough" technique clip)
    function isValidVideo() {
      return request.resource.size < 200 * 1024 * 1024 // 200MB max
             && request.resource.contentType.matches('video/.*');
    }
    
    // Helper function to validate image file (thumbnails)
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 // 5MB max
             && request.resource.contentType.matches('image/.*');
    }

    // Helper function to validate audio file (voice recordings)
    function isValidAudio() {
      return request.resource.size < 25 * 1024 * 1024 // 25MB max
             && request.resource.contentType.matches('audio/.*');
    }

    // ── Collector Shop item photos ──────────────────────────────────────
    // Photos live under collector/{shopId}/{itemId}/{file}. NOTE: Cloud Storage
    // rules cannot read Cloud Firestore (there is no cross-service get()), so we
    // can't verify shop membership here the way the Firestore rules do. Instead
    // access is gated by authentication plus the unguessable path: shopId and
    // itemId are random 20-char Firestore auto-IDs that non-members never see
    // (only shop members can read the item docs that contain the path), and
    // download URLs carry their own secret token. Writes must be valid images.
    //
    // If we ever need true membership enforcement at the Storage layer, the
    // path is a Cloud Function that mints custom auth claims for shop members;
    // that's the only way to bring membership into Storage rules.
    match /collector/{shopId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    // ── Workbook Reader ─────────────────────────────────────────────────
    // Shared, cross-user word-audio cache. Any signed-in user can read every
    // clip (so every child gets instant playback for words others already
    // tapped) and add a missing one. This MUST come before the per-adult
    // /workbook/{userId}/** rule below so "audio" isn't matched as a uid.
    // (Storage rules OR across matching allows, so the owner rule denying
    // isOwner('audio') can't block this.)
    match /workbook/audio/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidAudio();
    }

    // Original workbook page photos, owned by the adult whose uid is the first
    // path segment: workbook/{adultUid}/{kidId}/{pageId}/original.jpg
    match /workbook/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // User files path: users/{userId}/**
    match /users/{userId}/{allPaths=**} {
      // Allow read if authenticated user owns the files
      allow read: if isOwner(userId);
      
      // Allow write if authenticated user owns the files and file is valid
      allow write: if isOwner(userId) && (isValidVideo() || isValidImage() || isValidAudio());
      
      // Allow delete if authenticated user owns the files
      allow delete: if isOwner(userId);
    }
  }
}