rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy Gmail token store, keyed by email address and readable by
    // anyone. Tokens now live in /users/{uid}/private/gmail. Locked down
    // here so the old documents can't be read while they're being deleted.
    match /gmail_tokens/{email} {
      allow read, write: if false;
    }

    // Email Cache - Users can only access their own cached emails
    match /users/{userId} {
      // Users can only access their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Gmail OAuth tokens. Same owner-only rule as everything else under
      // /users, but kept in its own subcollection so it is never caught by
      // a broader match on the user document.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Email threads subcollection
      match /threads/{threadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Email messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sync metadata
      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Playball: timed playlists + batting-order lineups
      match /playball_playlists/{playlistId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /playball_lineups/{lineupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // CanITwo: community flags on reviews. Create-only, one per user per
    // review, enforced by requiring the doc id to embed the flagger's uid.
    // flagCount tallies are written by the canitwoFlags Cloud Function.
    match /canitwo_flags/{flagId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && flagId == request.resource.data.placeId + '__'
                   + request.resource.data.reviewUid + '__'
                   + request.auth.uid;
      allow update, delete: if false;
    }

    // CanITwo: community bathroom finder
    // Public read so travelers can browse without an account;
    // authenticated writes only. Emails are never stored in these docs.
    match /canitwo_users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /canitwo_usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /canitwo_places/{placeId} {
      allow read: if true;
      // Clients may only write base place fields — the rating aggregates
      // (yesCount, avgRating, tagCounts, flag counts…) are owned by the
      // canitwoAggregates Cloud Function, which bypasses these rules.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['name', 'category', 'emoji', 'lat', 'lng', 'geohash', 'address', 'source', 'updatedAt']);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['name', 'category', 'emoji', 'lat', 'lng', 'geohash', 'address', 'source', 'updatedAt']);
      allow delete: if false;

      // One review per user: doc id must be the reviewer's uid.
      // Edits are tamper-evident: every update must append the exact
      // previous version to `history`, must not alter existing history
      // entries or the original createdAt, and reviews can't be deleted
      // (delete-and-repost would launder the history).
      match /reviews/{reviewerUid} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == reviewerUid
          && request.resource.data.get('history', []) == [];
        allow update: if request.auth != null
          && request.auth.uid == reviewerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.history is list
          && request.resource.data.history.size() == resource.data.get('history', []).size() + 1
          && request.resource.data.history.size() <= 20
          && (resource.data.get('history', []).size() == 0
              || request.resource.data.history[0:resource.data.get('history', []).size()] == resource.data.history)
          && request.resource.data.history[request.resource.data.history.size() - 1] == {
               'hasBathroom': resource.data.hasBathroom,
               'rating': resource.data.get('rating', null),
               'text': resource.data.get('text', ''),
               'tags': resource.data.get('tags', []),
               'facility': resource.data.get('facility', null),
               'at': resource.data.updatedAt
             };
        allow delete: if false;
      }
    }

    // ── Recipe Box: family recipe cards gated by connections ─────────────
    // Profiles + usernames follow the canitwo pattern: usernames are the
    // public handle, emails never appear in shared docs.
    match /recipebox_users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /recipebox_usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Connections: doc id is both uids sorted and joined with '__', so there
    // can only ever be one connection per pair. The requester creates it as
    // 'pending'; only the *other* person can flip it to 'accepted'; either
    // side can delete (decline / cancel / disconnect).
    match /recipebox_connections/{connId} {
      // `resource == null` lets a signed-in user get() a connection doc that
      // doesn't exist yet (they just see "not found") — without it, the
      // duplicate-check before sending a request is denied outright.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.users);
      allow create: if request.auth != null
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.status == 'pending'
        && connId == request.resource.data.users[0] + '__' + request.resource.data.users[1]
        && request.resource.data.users[0] < request.resource.data.users[1];
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'respondedAt']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Recipe cards. Only the owner writes; readable by the owner, anyone the
    // card was handed to (sharedWith), and members of any group box the card
    // sits in (sharedGroups). Ownership can't be moved.
    //
    // Group membership is checked with indexed lookups because rules can't
    // loop — hence the fixed cap of 4 group boxes per card (mirrored in the
    // client). exists() guards make a deleted group fail closed, and
    // .get('sharedGroups', []) tolerates older docs without the field.
    function recipeInGroup(data, i) {
      return data.get('sharedGroups', []).size() > i
        && exists(/databases/$(database)/documents/recipebox_groups/$(data.sharedGroups[i]))
        && request.auth.uid in get(/databases/$(database)/documents/recipebox_groups/$(data.sharedGroups[i])).data.members;
    }
    match /recipebox_recipes/{recipeId} {
      // `resource == null` tolerates get() on a missing doc so a deleted or
      // unshared card reads as "not found" instead of a permissions error.
      allow read: if request.auth != null
        && (resource == null
            || request.auth.uid == resource.data.ownerUid
            || request.auth.uid in resource.data.sharedWith
            || recipeInGroup(resource.data, 0)
            || recipeInGroup(resource.data, 1)
            || recipeInGroup(resource.data, 2)
            || recipeInGroup(resource.data, 3));
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Group boxes: a shared shelf. Membership (not friendship) gates reading
    // what's on it; joining a box never touches anyone's connections. The
    // creator is the admin: only they invite, remove members, or delete.
    match /recipebox_groups/{groupId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.members);
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;
      allow update: if request.auth != null && (
        // Admin housekeeping (rename, remove members) — the box can't be
        // reassigned and the admin stays a member.
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.auth.uid in request.resource.data.members)
        ||
        // Self-join, with a standing invite as the ticket: may only add self.
        (exists(/databases/$(database)/documents/recipebox_group_invites/$(groupId + '__' + request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
          && request.resource.data.members.size() == resource.data.members.size() + 1)
        ||
        // Self-leave: may only remove self (the admin can't leave, only delete).
        (request.auth.uid != resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && resource.data.members.removeAll(request.resource.data.members) == [request.auth.uid]
          && resource.data.members.size() == request.resource.data.members.size() + 1)
      );
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // The cards on the shelf: an index of recipes members have shared in,
      // with snapshot fields for the grid (the recipe doc stays the truth).
      match /cards/{recipeId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/recipebox_groups/$(groupId)).data.members;
        allow create, update: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.recipeId == recipeId
          && request.auth.uid in get(/databases/$(database)/documents/recipebox_groups/$(groupId)).data.members;
        allow delete: if request.auth != null
          && (resource.data.ownerUid == request.auth.uid
              || get(/databases/$(database)/documents/recipebox_groups/$(groupId)).data.createdBy == request.auth.uid);
      }
    }

    // Group invites: doc id is groupId__inviteeUid, so one invite per person
    // per box. Only the box admin creates them; the invitee accepts (by
    // joining the group, above) or declines, and the admin can revoke.
    match /recipebox_group_invites/{inviteId} {
      allow read: if request.auth != null
        && (resource == null
            || request.auth.uid == resource.data.to
            || request.auth.uid == resource.data.from);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && inviteId == request.resource.data.groupId + '__' + request.resource.data.to
        && get(/databases/$(database)/documents/recipebox_groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
    }

    // ── Mise: convergence charts for implementation work ─────────────────
    // One document per implementation (the whole nested task tree lives in
    // the `tree` field), plus an append-only `events` ledger that timestamps
    // when each end step opened and closed. Private to the owner: ownership
    // is set at create and can never be reassigned.
    match /mise_implementations/{implId} {
      // `resource == null` lets a get() on a missing plan read as "not found"
      // instead of a permissions error — the same pattern the Recipe Box
      // collections use.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid == resource.data.ownerUid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Cycle-time ledger. Append-only on purpose: edits and deletes would
      // let the history be rewritten after the fact, which is the one thing
      // that would make the timings worthless.
      match /events/{eventId} {
        function ownsPlan() {
          return request.auth != null
            && exists(/databases/$(database)/documents/mise_implementations/$(implId))
            && get(/databases/$(database)/documents/mise_implementations/$(implId)).data.ownerUid == request.auth.uid;
        }
        allow read: if ownsPlan();
        allow create: if ownsPlan() && request.resource.data.actor == request.auth.uid;
        allow update: if false;
        // Deletes are allowed only so the client can clear the ledger when
        // the parent plan is deleted (Firestore does not cascade).
        allow delete: if ownsPlan();
      }
    }

    // Private /work pages (apps/portfolio/src/work). Saved state for the
    // sign-in-gated tools, one document per (user, page), with the document id
    // as `{uid}__{pageKey}`.
    //
    // This is where "only I can access it" is actually enforced. The client
    // allowlist in src/work/access.js can be bypassed by anyone willing to read
    // the bundle; these rules cannot. Two conditions, both required: the caller
    // owns the document, and the caller's verified Google address is on the
    // allowlist below. Keep this list in sync with src/work/access.js.
    match /work_private/{docId} {
      function isAllowedAccount() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in ['joshua.cocciardi@gmail.com'];
      }
      function ownsDoc() {
        return request.auth != null && docId.split('__')[0] == request.auth.uid;
      }

      // `resource` is null when the document doesn't exist yet. Without that
      // branch the very first load of a page — before anything has been saved —
      // fails on `resource.data` and reads as permission-denied rather than
      // "nothing saved yet".
      allow read: if isAllowedAccount() && ownsDoc()
        && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isAllowedAccount() && ownsDoc()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAllowedAccount() && ownsDoc()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isAllowedAccount() && ownsDoc()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ── Gatekeeper: parental web-filter accounts ────────────────────────
    // A household is the unit of ownership: one or more parent accounts
    // (`owners`) who can see everything under it. The child's browser
    // extension is NOT a Firebase-auth client — it talks to the Cloud
    // Functions HTTP API with a per-device bearer token, and those writes
    // (activity, sessions, incoming requests) land via the Admin SDK, which
    // bypasses these rules. So the client rules below only ever govern the
    // parent app: owners read their household and act on requests; the
    // Anthropic API key is write-only and never readable by any client.
    function gkOwners(hid) {
      return get(/databases/$(database)/documents/gatekeeper_households/$(hid)).data.owners;
    }
    function gkIsOwner(hid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/gatekeeper_households/$(hid))
        && request.auth.uid in gkOwners(hid);
    }

    match /gatekeeper_households/{hid} {
      // `resource == null` lets a signed-in parent get() a household that
      // doesn't exist yet (reads as "not found" rather than denied).
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.owners);
      // A parent creates their own household with themselves as sole owner.
      allow create: if request.auth != null
        && request.resource.data.owners == [request.auth.uid];
      // Owners can update, but may never write themselves out of the owners
      // list (that would orphan the household or hand it off silently).
      allow update: if request.auth != null
        && request.auth.uid in resource.data.owners
        && request.auth.uid in request.resource.data.owners;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.owners;

      // Secret config — the household's Anthropic API key. Owners may write
      // it, but NO client may ever read it back. It is consumed only by the
      // screening Cloud Function via the Admin SDK.
      match /private/{docId} {
        allow read: if false;
        allow write: if gkIsOwner(hid);
      }

      // Paired child devices and parent push registrations. Extension device
      // records are minted by the Cloud Function (admin); the parent app
      // registers its own FCM push token here.
      match /devices/{deviceId} {
        allow read: if gkIsOwner(hid);
        allow write: if gkIsOwner(hid);
      }

      // Browsing sessions (goal per stretch), mirrored activity log, and the
      // real-time access requests the child raises. Extension writes arrive
      // via the Admin SDK; the parent app reads them and, for requests,
      // flips status to approved/denied.
      match /sessions/{sessionId} {
        allow read, write: if gkIsOwner(hid);
      }
      match /activity/{eventId} {
        allow read, write: if gkIsOwner(hid);
      }
      match /requests/{requestId} {
        allow read, write: if gkIsOwner(hid);
      }
    }

    // Pairing codes: short-lived code → household lookups the /pair endpoint
    // (Admin SDK) redeems. An owner creates a code for their own household;
    // codes are never client-readable, so they can't be enumerated.
    match /gatekeeper_pairing/{code} {
      allow read: if false;
      allow create: if gkIsOwner(request.resource.data.householdId);
      allow update: if false;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/gatekeeper_households/$(resource.data.householdId))
        && request.auth.uid in gkOwners(resource.data.householdId);
    }

    // Radar metadata - read access for clients
    match /radar_sites/{siteId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /radar_scans/{scanId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Client usage tracking (optional)
    match /client_usage/{clientId} {
      allow read, write: if true;
    }
    
    // Default authenticated access for other collections.
    // CanITwo, Recipe Box, Mise, /work and the per-user `users` tree are excluded —
    // without this carve-out, the catch-all would override their stricter
    // rules above (in Firestore, any matching `allow` wins), and every
    // signed-in user could read and write everyone else's documents.
    //
    // `users` matters most: anyone can create an account, so without the
    // exclusion below every signed-in user could read every other user's
    // cached mail and OAuth tokens.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && collection != 'users'
        && collection != 'gmail_tokens'
        && !collection.matches('canitwo_.*')
        && !collection.matches('recipebox_.*')
        && !collection.matches('mise_.*')
        && !collection.matches('gatekeeper_.*')
        && collection != 'work_private';
    }
  }
}
