{
  "rules": {
    ".read": false,
    ".write": false,
    "tophat": {
      "rooms": {
        ".read": false,
        ".write": false,
        "$room": {
          ".read": "auth != null && $room.matches(/^[0-9a-f]{64}$/)",
          ".write": "auth != null && $room.matches(/^[0-9a-f]{64}$/)",
          "players": {
            "$uid": {
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
              "role": { ".validate": "newData.val() === 'tophat' || newData.val() === 'spear'" }
            }
          },
          "inputs": {
            "$uid": { ".validate": "$uid === auth.uid" }
          },
          "cmds": {
            "$cmd": { ".validate": "newData.child('uid').val() === auth.uid" }
          },
          "$other": {
            ".validate": "$other.matches(/^(meta|players|request|state|full|inputs|cmds)$/)"
          }
        }
      }
    },
    "party": {
      "rooms": {
        ".read": false,
        ".write": false,
        "$code": {
          "meta": {
            ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/)",
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && (!data.exists() || data.child('host').val() === auth.uid) && newData.child('host').isString()",
            "host": {
              ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && newData.val() === auth.uid && root.child('party/rooms/' + $code + '/players/' + auth.uid).exists() && root.child('party/rooms/' + $code + '/players/' + data.val() + '/online').val() !== true",
              ".validate": "newData.isString()"
            },
            "created": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "players": {
            ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/)",
            "$uid": {
              ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && ($uid === auth.uid || root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid)",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "joined": {
                ".validate": "newData.isNumber()"
              },
              "online": {
                ".validate": "newData.isBoolean()"
              },
              "leftAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "game": {
            ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/)",
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid"
          },
          "vault": {
            ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid",
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid"
          },
          "secret": {
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid",
            "$uid": {
              ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && $uid === auth.uid"
            }
          },
          "notes": {
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid",
            "$uid": {
              ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && $uid === auth.uid"
            }
          },
          "inbox": {
            ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid",
            "$msg": {
              ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('party/rooms/' + $code + '/players/' + auth.uid).exists()) || (root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.child('t').isString() && newData.child('t').val().length <= 12)"
            }
          },
          "strokes": {
            ".read": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/)",
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && (root.child('party/rooms/' + $code + '/meta/host').val() === auth.uid || root.child('party/rooms/' + $code + '/game/drawer').val() === auth.uid)",
            "$s": {
              ".validate": "newData.hasChildren(['p'])"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "roy": {
      ".read": false,
      ".write": false,
      "users": {
        ".read": "auth != null",
        "$uid": {
          "username": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "email": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val() === auth.token.email"
          },
          "friendCode": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}$/)"
          },
          "friends": {
            "$friendId": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true"
            }
          },
          "notifications": {
            ".write": "auth != null && auth.uid === $uid",
            "$type": {
              ".validate": "newData.isBoolean() && $type.matches(/^(turns|invites|emotes)$/)"
            }
          },
          "pushToken": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length < 512"
          },
          "webPushTokens": {
            "$token": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true"
            }
          },
          "features": {
            ".write": false
          }
        }
      },
      "games": {
        ".read": "auth != null",
        "$gameId": {
          ".write": "auth != null && (data.child('player1').val() === auth.uid || data.child('player2').val() === auth.uid || (!data.exists() && newData.child('player1').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['player1', 'player2']) && (!data.exists() || (newData.child('player1').val() === data.child('player1').val() && newData.child('player2').val() === data.child('player2').val())))"
        }
      }
    }
  }
}
