# Firebase web config for the shared josh-cocciardi project. Copy to .env.local
# and fill in from the Firebase console (Project settings → Your apps → Web app).
# These are the same values the other apps in this monorepo use.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
