# Copy to .env and fill in. Everything here ships in the browser bundle —
# these are public client identifiers, not secrets. Real secrets must never
# live in a REACT_APP_* variable.

# Firebase web app config (Firebase console → Project settings → Your apps)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Google OAuth 2.0 Client ID (Google Cloud console → APIs & Services →
# Credentials → OAuth 2.0 Client ID, type "Web application").
# Authorized JavaScript origins must include every origin you serve from,
# e.g. http://localhost:3000 and https://www.joshcocciardi.com
REACT_APP_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
