# Placeholder config for the test run. Nothing here reaches a real service:
# Firebase is mocked in the tests that need it, and Google Identity Services
# is replaced with a fake. These values only need to be non-empty so the
# modules under test get past their "is this configured?" guards.

REACT_APP_FIREBASE_API_KEY=test-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=test-project
REACT_APP_FIREBASE_STORAGE_BUCKET=test-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:testtesttest
REACT_APP_GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
