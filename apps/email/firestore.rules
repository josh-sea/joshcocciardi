rules_version = '2';

// Rules for the mail app's own collections.
//
// The deployed ruleset is the one at the repository root — it covers every
// app on the project, and this file is not deployed on its own. This is the
// mail-app slice of it, kept here so the app's storage model is readable in
// one place; keep the two in step.
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy token store, keyed by email address and world-readable.
    // Superseded by /users/{uid}/private/gmail. Denied outright so the old
    // documents can't be read while they're being cleaned up.
    match /gmail_tokens/{email} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Gmail OAuth access tokens — owner only.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cached threads, messages and sync state — owner only.
      match /threads/{threadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
