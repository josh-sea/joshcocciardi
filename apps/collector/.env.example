# Firebase config for the shared josh-cocciardi project.
# Copy to .env.local and fill in from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=josh-cocciardi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=josh-cocciardi
VITE_FIREBASE_STORAGE_BUCKET=josh-cocciardi.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
