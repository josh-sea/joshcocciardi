VITE_FIREBASE_AUTH_DOMAIN=josh-cocciardi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=josh-cocciardi
VITE_FIREBASE_STORAGE_BUCKET=josh-cocciardi.firebasestorage.app
