{
  "hosting": [
    {
      "target": "portfolio",
      "public": "apps/portfolio/build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/projects/moments/**",
          "destination": "/projects/moments/index.html"
        },
        {
          "source": "/projects/electronic-mail/**",
          "destination": "/projects/electronic-mail/index.html"
        },
        {
          "source": "/projects/playball/**",
          "destination": "/projects/playball/index.html"
        },
        {
          "source": "/projects/canitwo/**",
          "destination": "/projects/canitwo/index.html"
        },
        {
          "source": "/projects/recipebox/**",
          "destination": "/projects/recipebox/index.html"
        },
        {
          "source": "/projects/collector/**",
          "destination": "/projects/collector/index.html"
        },
        {
          "source": "/projects/workbook/**",
          "destination": "/projects/workbook/index.html"
        },
        {
          "source": "/projects/psx/**",
          "destination": "/projects/psx/index.html"
        },
        {
          "source": "!/projects/**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/work/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/projects/moments/**",
          "headers": [
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "Cross-Origin-Embedder-Policy",
              "value": "require-corp"
            }
          ]
        },
        {
          "source": "/projects/canitwo/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/recipebox/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/psx/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "gramandpops",
      "public": "apps/recipebox",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "igatekeeper",
      "public": "apps/gatekeeper/app",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
