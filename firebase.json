{
  "hosting": [
    {
      "target": "portfolio",
      "public": "apps/portfolio/build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/projects/moments/**",
          "destination": "/projects/moments/index.html"
        },
        {
          "source": "/projects/electronic-mail/**",
          "destination": "/projects/electronic-mail/index.html"
        },
        {
          "source": "/projects/playball/**",
          "destination": "/projects/playball/index.html"
        },
        {
          "source": "/projects/canitwo/**",
          "destination": "/projects/canitwo/index.html"
        },
        {
          "source": "/projects/recipebox/**",
          "destination": "/projects/recipebox/index.html"
        },
        {
          "source": "/projects/collector/**",
          "destination": "/projects/collector/index.html"
        },
        {
          "source": "/projects/workbook/**",
          "destination": "/projects/workbook/index.html"
        },
        {
          "source": "/projects/psx/**",
          "destination": "/projects/psx/index.html"
        },
        {
          "source": "/projects/solra/**",
          "destination": "/projects/solra/index.html"
        },
        {
          "source": "/projects/disney-trivia/**",
          "destination": "/projects/disney-trivia/index.html"
        },
        {
          "source": "/projects/tophat-spears/**",
          "destination": "/projects/tophat-spears/index.html"
        },
        {
          "source": "!/projects/**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/work/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/tools/seasonal-box{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/projects/moments/**",
          "headers": [
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "Cross-Origin-Embedder-Policy",
              "value": "require-corp"
            }
          ]
        },
        {
          "source": "/projects/canitwo/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/recipebox/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/psx/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/solra/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/swing-coach/**/*.@(js|mjs|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/disney-trivia/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/tophat-spears/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/projects/tophat-spears/models/*.glb",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            },
            {
              "key": "Content-Type",
              "value": "model/gltf-binary"
            }
          ]
        },
        {
          "source": "/projects/disney-trivia/maps/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, noimageindex"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "/projects/disney-trivia/music/*.@(mp3|m4a|aac|wav|ogg)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/hulk-game",
          "destination": "/projects/boulder-smash/",
          "type": 301
        },
        {
          "source": "/projects/whereami{,/**}",
          "destination": "/projects/disney-trivia/#whereami",
          "type": 301
        },
        {
          "source": "/tophat",
          "destination": "/projects/tophat-spears/",
          "type": 301
        }
      ]
    },
    {
      "target": "gramandpops",
      "public": "apps/recipebox",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "igatekeeper",
      "public": "apps/gatekeeper/app",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "ezpayze",
      "public": "apps/ezpayze/web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "!/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/pay/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ]
    },
    {
      "target": "roy",
      "public": "apps/roy/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/delete-account",
          "function": {
            "functionId": "roy-deleteAccount",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "!/_expo/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/_expo/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    },
    {
      "source": "apps/ezpayze/functions",
      "codebase": "ezpayze",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "test-rules",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    },
    {
      "source": "apps/roy/functions",
      "codebase": "roy",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    }
  }
}
